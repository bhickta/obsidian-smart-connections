  "bugs": {
    "url": "https://github.com/brianpetro/obsidian-smart-connections/issues"
  },
  "homepage": "https://smartconnections.app",
  "devDependencies": {
    "@xenova/transformers": "latest",
    "archiver": "^6.0.1",
    "ava": "^6.0.1",
    "axios": "^1.6.7",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.9",
    "swagger-jsdoc": "^6.2.8"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.19",
